# Clerk (Authentication)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Neon (Database)
# Use pooler endpoint for connection pooling: ep-xxx-pooler.us-east-1.aws.neon.tech
DATABASE_URL=postgres://user:pass@ep-xxx-pooler.neon.tech/neondb?sslmode=require&pgbouncer=true

# Stripe (Billing)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# New pricing tiers
STRIPE_SINGLE_PRICE_ID=price_xxx    # $49 one-time
STRIPE_CREATOR_PRICE_ID=price_xxx   # $299/month subscription (10 parodies)
STRIPE_PRO_PRICE_ID=price_xxx       # $599/month subscription (unlimited)

# Anthropic (Claude API)
ANTHROPIC_API_KEY=sk-ant-xxx

# Resend (Email notifications)
RESEND_API_KEY=re_xxx

# Upstash Redis (Caching & Rate Limiting)
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx

# Kill Switches (set to 'true' to enable)
KILL_NEW_GENERATIONS=false
KILL_CLAUDE_API=false
MAINTENANCE_MODE=false

# Load Control
MAX_CONCURRENT_GENERATIONS=10
DAILY_BUDGET_CENTS=10000

# Health Check (for monitoring)
HEALTH_CHECK_KEY=your-secret-health-key

# Test bypass (optional - for development only)
TEST_BYPASS_KEY=test123

# Migration key (one-time use, keep secret)
MIGRATION_KEY=your-secret-migration-key

# Internal function auth (required in production — generate-parody-background
# rejects any request that doesn't carry this exact value in x-internal-secret)
INTERNAL_FUNCTION_SECRET=your-secret-internal-key
